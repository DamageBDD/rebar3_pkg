# -*- mode: sh; sh-shell: bash; sh-basic-offset: 2; indent-tabs-mode: nil; -*-

# -*- mode: sh; sh-shell: bash; sh-basic-offset: 2; indent-tabs-mode: nil; -*-

run_postinst_hooks() {
  phase="$1"
  shift

  install_dir="{{install_prefix}}/{{app}}"
  hook_dir="${install_dir}/postinst.d"

  [ -d "$hook_dir" ] || return 0

  for hook in "$hook_dir"/*; do
    [ -f "$hook" ] || continue
    [ -x "$hook" ] || continue

    echo ">>> running ${hook} ${phase}"
    "$hook" "$phase" "$@"
  done
}

post_install() {
  run_postinst_hooks post_install "$@"
}

post_upgrade() {
  run_postinst_hooks post_upgrade "$@"
}

pre_remove() {
  run_postinst_hooks pre_remove "$@"
}

post_remove() {
  :
}
